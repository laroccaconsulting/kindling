{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "explanation_of_benefit_item",
  "title": "Explanation of benefit lines",
  "status": "active",
  "description": "One row per ExplanationOfBenefit.item (claim line) with line-level adjudication amounts.",
  "resource": "ExplanationOfBenefit",
  "select": [
    {
      "column": [
        {
          "name": "eob_id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "patient_id",
          "path": "patient.getReferenceKey(Patient)",
          "type": "id"
        },
        {
          "name": "claim_type",
          "path": "type.coding.first().code",
          "type": "code"
        }
      ]
    },
    {
      "forEach": "item",
      "column": [
        {
          "name": "sequence",
          "path": "sequence",
          "type": "positiveInt"
        },
        {
          "name": "product_system",
          "path": "productOrService.coding.first().system",
          "type": "uri"
        },
        {
          "name": "product_code",
          "path": "productOrService.coding.first().code",
          "type": "code"
        },
        {
          "name": "product_display",
          "path": "(productOrService.coding.first().display | productOrService.text).first()",
          "type": "string"
        },
        {
          "name": "service_start",
          "path": "(serviced.ofType(Period).start | serviced.ofType(date)).first()",
          "type": "dateTime"
        },
        {
          "name": "service_end",
          "path": "serviced.ofType(Period).end",
          "type": "dateTime"
        },
        {
          "name": "place_of_service_code",
          "path": "location.ofType(CodeableConcept).coding.first().code",
          "type": "code"
        },
        {
          "name": "category_code",
          "path": "category.coding.first().code",
          "type": "code"
        },
        {
          "name": "quantity",
          "path": "quantity.value",
          "type": "decimal"
        },
        {
          "name": "net_amount",
          "path": "net.value",
          "type": "decimal"
        },
        {
          "name": "submitted_amount",
          "path": "adjudication.where(category.coding.code = 'https://bluebutton.cms.gov/resources/variables/line_sbmtd_chrg_amt').amount.value.first()",
          "type": "decimal"
        },
        {
          "name": "allowed_amount",
          "path": "adjudication.where(category.coding.code = 'https://bluebutton.cms.gov/resources/variables/line_alowd_chrg_amt').amount.value.first()",
          "type": "decimal"
        },
        {
          "name": "paid_amount",
          "path": "adjudication.where(category.coding.code = 'https://bluebutton.cms.gov/resources/variables/line_prvdr_pmt_amt').amount.value.first()",
          "type": "decimal"
        },
        {
          "name": "coinsurance_amount",
          "path": "adjudication.where(category.coding.code = 'https://bluebutton.cms.gov/resources/variables/line_coinsrnc_amt').amount.value.first()",
          "type": "decimal"
        },
        {
          "name": "deductible_amount",
          "path": "adjudication.where(category.coding.code = 'https://bluebutton.cms.gov/resources/variables/line_bene_ptb_ddctbl_amt').amount.value.first()",
          "type": "decimal"
        },
        {
          "name": "diagnosis_sequence",
          "path": "diagnosisSequence.first()",
          "type": "positiveInt"
        },
        {
          "name": "encounter_id",
          "path": "encounter.first().getReferenceKey(Encounter)",
          "type": "id"
        }
      ]
    }
  ]
}

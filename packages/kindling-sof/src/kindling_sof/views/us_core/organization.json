{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "organization",
  "title": "Organizations",
  "status": "active",
  "description": "One row per Organization (providers and payers).",
  "resource": "Organization",
  "select": [
    {
      "column": [
        {
          "name": "id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "source_identifier",
          "path": "identifier.where(system = 'https://github.com/synthetichealth/synthea').value.first()",
          "type": "string"
        },
        {
          "name": "npi",
          "path": "identifier.where(system = 'http://hl7.org/fhir/sid/us-npi').value.first()",
          "type": "string"
        },
        {
          "name": "name",
          "path": "name",
          "type": "string"
        },
        {
          "name": "type_code",
          "path": "type.first().coding.first().code",
          "type": "code"
        },
        {
          "name": "address_line",
          "path": "address.first().line.join(', ')",
          "type": "string"
        },
        {
          "name": "city",
          "path": "address.first().city",
          "type": "string"
        },
        {
          "name": "state",
          "path": "address.first().state",
          "type": "string"
        },
        {
          "name": "postal_code",
          "path": "address.first().postalCode",
          "type": "string"
        },
        {
          "name": "phone",
          "path": "telecom.where(system = 'phone').value.first()",
          "type": "string"
        }
      ]
    }
  ]
}

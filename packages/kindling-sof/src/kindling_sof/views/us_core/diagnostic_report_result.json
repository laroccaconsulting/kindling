{
  "resourceType": "https://sql-on-fhir.org/ig/StructureDefinition/ViewDefinition",
  "name": "diagnostic_report_result",
  "title": "Diagnostic report results",
  "status": "active",
  "description": "One row per DiagnosticReport.result: links lab panels (orders) to their result Observations.",
  "resource": "DiagnosticReport",
  "select": [
    {
      "column": [
        {
          "name": "diagnostic_report_id",
          "path": "getResourceKey()",
          "type": "id"
        },
        {
          "name": "patient_id",
          "path": "subject.getReferenceKey(Patient)",
          "type": "id"
        },
        {
          "name": "encounter_id",
          "path": "encounter.getReferenceKey(Encounter)",
          "type": "id"
        },
        {
          "name": "status",
          "path": "status",
          "type": "code"
        },
        {
          "name": "category",
          "path": "category.first().coding.first().code",
          "type": "code"
        },
        {
          "name": "code_system",
          "path": "code.coding.first().system",
          "type": "uri"
        },
        {
          "name": "code_code",
          "path": "code.coding.first().code",
          "type": "code"
        },
        {
          "name": "code_display",
          "path": "(code.coding.first().display | code.text).first()",
          "type": "string"
        },
        {
          "name": "effective_datetime",
          "path": "effective.ofType(dateTime)",
          "type": "dateTime"
        },
        {
          "name": "issued",
          "path": "issued",
          "type": "instant"
        }
      ]
    },
    {
      "forEach": "result",
      "column": [
        {
          "name": "observation_id",
          "path": "getReferenceKey(Observation)",
          "type": "id"
        }
      ]
    }
  ]
}
